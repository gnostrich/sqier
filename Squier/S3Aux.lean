module

public import Mathlib
public import Squier.Defs

@[expose] public section

/-!
# Auxiliary results for the example `S₃`

* an additive invariant of zig-zag paths (signed count of `aa → ε` steps, weighted by the
  parity of the left context) that is preserved by the homotopy relation generated by the empty
  set of cells, whence the non-degeneracy of the critical pair `a·a·a`;
* termination of `s3` (the weight `3 |w| + |w|_b` decreases along every step);
* the classification of the critical branchings of `s3` (ten ordered branchings);
* for each of them, a resolution whose cell is one of the five cells of `s3Basis`.
-/

namespace Squier

namespace S3Aux

/-! ### An invariant of the homotopy relation without cells -/

/-- The weight of a step: `±1` for a step `aa → ε`, the sign being the parity of the length of
the left context, and `0` for the other rules. -/
def stepWeight {u v : List (Fin 2)} (s : Step s3 u v) : ℤ :=
  if s.rule = ([0, 0], []) then (-1) ^ s.pre.length else 0

/-- The weight of a zig-zag path: forward steps count positively, backward steps negatively. -/
def weight : {u v : List (Fin 2)} → Path s3 u v → ℤ
  | _, _, .nil _ => 0
  | _, _, .fwd p s => weight p + stepWeight s
  | _, _, .bwd p s => weight p - stepWeight s

theorem weight_comp {u v w : List (Fin 2)} (p : Path s3 u v) (q : Path s3 v w) :
    weight (p.comp q) = weight p + weight q := by
  induction q with
  | nil => simp [Path.comp, weight]
  | fwd q s ih => simp only [Path.comp, weight, ih]; ring
  | bwd q s ih => simp only [Path.comp, weight, ih]; ring

theorem weight_inv {u v : List (Fin 2)} (p : Path s3 u v) : weight p.inv = - weight p := by
  induction p with
  | nil => simp [Path.inv, weight]
  | fwd p s ih => simp only [Path.inv, weight_comp, weight, ih]; ring
  | bwd p s ih => simp only [Path.inv, weight_comp, weight, ih]; ring

theorem stepWeight_whisker {u v : List (Fin 2)} (x y : List (Fin 2)) (s : Step s3 u v) :
    stepWeight (s.whisker x y) = (-1) ^ x.length * stepWeight s := by
  unfold stepWeight
  simp only [Step.whisker, List.length_append, pow_add]
  split_ifs <;> simp

theorem weight_whisker {u v : List (Fin 2)} (x y : List (Fin 2)) (p : Path s3 u v) :
    weight (p.whisker x y) = (-1) ^ x.length * weight p := by
  induction p with
  | nil => simp [Path.whisker, weight]
  | fwd p s ih => simp only [Path.whisker, weight, ih, stepWeight_whisker]; ring
  | bwd p s ih => simp only [Path.whisker, weight, ih, stepWeight_whisker]; ring

/-- Every rule of `s3` preserves the parity of the length. -/
theorem parity_rule {ρ : List (Fin 2) × List (Fin 2)} (h : ρ ∈ s3) :
    ((-1 : ℤ)) ^ ρ.2.length = (-1) ^ ρ.1.length := by
  simp only [s3, Finset.mem_insert, Finset.mem_singleton] at h
  rcases h with rfl | rfl | rfl <;> norm_num

theorem weight_indep (a b c : List (Fin 2)) {ρ₁ ρ₂ : List (Fin 2) × List (Fin 2)}
    (h₁ : ρ₁ ∈ s3) (h₂ : ρ₂ ∈ s3) :
    weight (indepLeft a b c h₁ h₂) = weight (indepRight a b c h₁ h₂) := by
  simp only [indepLeft, indepRight, weight, stepWeight, List.length_append, pow_add,
    parity_rule h₁]
  ring

theorem weight_homotopic {u v : List (Fin 2)} {p q : Path s3 u v}
    (h : Homotopic (∅ : Set (Cell s3)) p q) : weight p = weight q := by
  induction h with
  | basis h => simp at h
  | indep a b c h₁ h₂ => exact weight_indep a b c h₁ h₂
  | fwd_bwd s => simp [weight, Step.toPath]
  | bwd_fwd s => simp [weight]
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | comp _ _ ih₁ ih₂ => rw [weight_comp, weight_comp, ih₁, ih₂]
  | inv _ ih => rw [weight_inv, weight_inv, ih]
  | whisker x y _ ih => rw [weight_whisker, weight_whisker, ih]

theorem homotopy_nondegenerate :
    ¬ Homotopic (∅ : Set (Cell s3)) s3StepAAALeft.toPath s3StepAAARight.toPath := by
  intro h
  have := weight_homotopic h
  simp [weight, stepWeight, Step.toPath, s3StepAAALeft, s3StepAAARight] at this

/-! ### Termination -/

/-- A weight on words that decreases along every step of `s3`. -/
def mu (w : List (Fin 2)) : ℕ := 3 * w.length + w.count 1

theorem mu_lt {u v : List (Fin 2)} (s : Step s3 u v) : mu v < mu u := by
  obtain ⟨pre, ⟨l, r⟩, mem, suf, rfl, rfl⟩ := s
  simp only [s3, Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq] at mem
  simp only [mu, List.length_append, List.count_append]
  rcases mem with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · simp
  · simp; omega
  · simp

theorem terminating : Terminating s3 :=
  Subrelation.wf (r := InvImage (· < ·) mu) (fun {_ _} h => h.elim fun s => mu_lt s)
    (InvImage.wf mu wellFounded_lt)

/-! ### Classification of the critical branchings -/

/-- The ten ordered critical branchings of `s3`, described by the contexts and rules of their
two steps `(p₁, r₁, s₁)` and `(p₂, r₂, s₂)`. -/
def IsCrit (p₁ : List (Fin 2)) (r₁ : List (Fin 2) × List (Fin 2)) (s₁ p₂ : List (Fin 2))
    (r₂ : List (Fin 2) × List (Fin 2)) (s₂ : List (Fin 2)) : Prop :=
  -- `a·a·a`
  (p₁ = [] ∧ r₁ = ([0, 0], []) ∧ s₁ = [0] ∧ p₂ = [0] ∧ r₂ = ([0, 0], []) ∧ s₂ = []) ∨
  (p₁ = [0] ∧ r₁ = ([0, 0], []) ∧ s₁ = [] ∧ p₂ = [] ∧ r₂ = ([0, 0], []) ∧ s₂ = [0]) ∨
  -- `b·b·b`
  (p₁ = [] ∧ r₁ = ([1, 1], []) ∧ s₁ = [1] ∧ p₂ = [1] ∧ r₂ = ([1, 1], []) ∧ s₂ = []) ∨
  (p₁ = [1] ∧ r₁ = ([1, 1], []) ∧ s₁ = [] ∧ p₂ = [] ∧ r₂ = ([1, 1], []) ∧ s₂ = [1]) ∨
  -- `b·b·ab`
  (p₁ = [] ∧ r₁ = ([1, 1], []) ∧ s₁ = [0, 1] ∧ p₂ = [1] ∧ r₂ = ([1, 0, 1], [0, 1, 0]) ∧
    s₂ = []) ∨
  (p₁ = [1] ∧ r₁ = ([1, 0, 1], [0, 1, 0]) ∧ s₁ = [] ∧ p₂ = [] ∧ r₂ = ([1, 1], []) ∧
    s₂ = [0, 1]) ∨
  -- `ba·b·b`
  (p₁ = [] ∧ r₁ = ([1, 0, 1], [0, 1, 0]) ∧ s₁ = [1] ∧ p₂ = [1, 0] ∧ r₂ = ([1, 1], []) ∧
    s₂ = []) ∨
  (p₁ = [1, 0] ∧ r₁ = ([1, 1], []) ∧ s₁ = [] ∧ p₂ = [] ∧ r₂ = ([1, 0, 1], [0, 1, 0]) ∧
    s₂ = [1]) ∨
  -- `ba·b·ab`
  (p₁ = [] ∧ r₁ = ([1, 0, 1], [0, 1, 0]) ∧ s₁ = [0, 1] ∧ p₂ = [1, 0] ∧
    r₂ = ([1, 0, 1], [0, 1, 0]) ∧ s₂ = []) ∨
  (p₁ = [1, 0] ∧ r₁ = ([1, 0, 1], [0, 1, 0]) ∧ s₁ = [] ∧ p₂ = [] ∧
    r₂ = ([1, 0, 1], [0, 1, 0]) ∧ s₂ = [0, 1])

theorem lhs_length {ρ : List (Fin 2) × List (Fin 2)} (h : ρ ∈ s3) :
    2 ≤ ρ.1.length ∧ ρ.1.length ≤ 3 := by
  simp only [s3, Finset.mem_insert, Finset.mem_singleton] at h
  rcases h with rfl | rfl | rfl <;> simp

theorem list_le1 (l : List (Fin 2)) (h : l.length ≤ 1) : l = [] ∨ l = [0] ∨ l = [1] := by
  rcases l with _ | ⟨a, _ | ⟨b, l⟩⟩
  · simp
  · fin_cases a <;> simp
  · simp at h

theorem list_le2 (l : List (Fin 2)) (h : l.length ≤ 2) :
    l = [] ∨ l = [0] ∨ l = [1] ∨ l = [0, 0] ∨ l = [0, 1] ∨ l = [1, 0] ∨ l = [1, 1] := by
  rcases l with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩
  · simp
  · fin_cases a <;> simp
  · fin_cases a <;> fin_cases b <;> simp
  · simp at h

/-- In an overlap `l₁ ++ s₁ = p₂ ++ l₂` that is not a disjoint juxtaposition, the left
context of the second factor is shorter than the first factor. -/
theorem overlap_bound {β : Type*} {l₁ s₁ p₂ l₂ : List β} (h : l₁ ++ s₁ = p₂ ++ l₂)
    (hni : ¬ ∃ b, p₂ = l₁ ++ b ∧ s₁ = b ++ l₂) : p₂.length < l₁.length := by
  rcases List.append_eq_append_iff.mp h with ⟨a', h₁, h₂⟩ | ⟨c', h₁, h₂⟩
  · exact absurd ⟨a', h₁, h₂⟩ hni
  · subst h₁
    rcases c' with _ | ⟨x, c'⟩
    · exact absurd ⟨[], by simp, by simpa using h₂.symm⟩ hni
    · simp

theorem classify {p₁ s₁ p₂ s₂ : List (Fin 2)} {r₁ r₂ : List (Fin 2) × List (Fin 2)}
    (m₁ : r₁ ∈ s3) (m₂ : r₂ ∈ s3) (hsrc : p₁ ++ r₁.1 ++ s₁ = p₂ ++ r₂.1 ++ s₂)
    (hne : p₁ ≠ p₂ ∨ r₁ ≠ r₂)
    (hni₁ : ¬ ∃ b, p₂ = p₁ ++ r₁.1 ++ b ∧ s₁ = b ++ r₂.1 ++ s₂)
    (hni₂ : ¬ ∃ b, p₁ = p₂ ++ r₂.1 ++ b ∧ s₂ = b ++ r₁.1 ++ s₁)
    (hp : p₁ = [] ∨ p₂ = []) (hs : s₁ = [] ∨ s₂ = []) : IsCrit p₁ r₁ s₁ p₂ r₂ s₂ := by
  have hl₁ := lhs_length m₁
  have hl₂ := lhs_length m₂
  have hlen := congrArg List.length hsrc
  simp only [List.length_append] at hlen
  simp only [s3, Finset.mem_insert, Finset.mem_singleton] at m₁ m₂
  rcases hp with rfl | rfl <;> rcases hs with rfl | rfl
  · -- the first factor is the whole word
    clear hni₁ hni₂
    simp only [List.length_nil] at hlen
    rcases list_le1 p₂ (by omega) with rfl | rfl | rfl <;>
      rcases list_le1 s₂ (by omega) with rfl | rfl | rfl <;>
      rcases m₁ with rfl | rfl | rfl <;> rcases m₂ with rfl | rfl | rfl <;>
      simp_all
  · -- overlap, first factor on the left
    simp only [List.nil_append, List.append_nil] at hsrc hni₁
    have hlt := overlap_bound hsrc hni₁
    clear hni₁ hni₂
    rcases list_le2 p₂ (by omega) with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      rcases m₁ with rfl | rfl | rfl <;> rcases m₂ with rfl | rfl | rfl <;>
      simp_all [IsCrit]
  · -- overlap, second factor on the left
    simp only [List.nil_append, List.append_nil] at hsrc hni₂
    have hlt := overlap_bound hsrc.symm hni₂
    clear hni₁ hni₂
    rcases list_le2 p₁ (by omega) with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      rcases m₁ with rfl | rfl | rfl <;> rcases m₂ with rfl | rfl | rfl <;>
      simp_all [IsCrit]
  · -- the second factor is the whole word
    clear hni₁ hni₂
    simp only [List.length_nil] at hlen
    rcases list_le1 p₁ (by omega) with rfl | rfl | rfl <;>
      rcases list_le1 s₁ (by omega) with rfl | rfl | rfl <;>
      rcases m₁ with rfl | rfl | rfl <;> rcases m₂ with rfl | rfl | rfl <;>
      simp_all

/-! ### Resolutions of the critical branchings -/

/-- The resolution `baba → abaa → ab` of the critical pair `b·b·ab`. -/
def resBBAB : Path s3 [1, 0, 1, 0] [0, 1] :=
  ((Path.nil _).fwd (⟨[], ([1, 0, 1], [0, 1, 0]), by simp [s3], [0], rfl, rfl⟩ :
      Step s3 [1, 0, 1, 0] [0, 1, 0, 0])).fwd
    (⟨[0, 1], ([0, 0], []), by simp [s3], [], rfl, rfl⟩ : Step s3 [0, 1, 0, 0] [0, 1])

/-- The resolution `abab → aaba → ba` of the critical pair `ba·b·b`. -/
def resBABB : Path s3 [0, 1, 0, 1] [1, 0] :=
  ((Path.nil _).fwd (⟨[0], ([1, 0, 1], [0, 1, 0]), by simp [s3], [], rfl, rfl⟩ :
      Step s3 [0, 1, 0, 1] [0, 0, 1, 0])).fwd
    (⟨[], ([0, 0], []), by simp [s3], [1, 0], rfl, rfl⟩ : Step s3 [0, 0, 1, 0] [1, 0])

/-- The resolution `abaab → abb → a` of the critical pair `ba·b·ab` (left side). -/
def resBABABLeft : Path s3 [0, 1, 0, 0, 1] [0] :=
  ((Path.nil _).fwd (⟨[0, 1], ([0, 0], []), by simp [s3], [1], rfl, rfl⟩ :
      Step s3 [0, 1, 0, 0, 1] [0, 1, 1])).fwd
    (⟨[0], ([1, 1], []), by simp [s3], [], rfl, rfl⟩ : Step s3 [0, 1, 1] [0])

/-- The resolution `baaba → bba → a` of the critical pair `ba·b·ab` (right side). -/
def resBABABRight : Path s3 [1, 0, 0, 1, 0] [0] :=
  ((Path.nil _).fwd (⟨[1], ([0, 0], []), by simp [s3], [1, 0], rfl, rfl⟩ :
      Step s3 [1, 0, 0, 1, 0] [1, 1, 0])).fwd
    (⟨[], ([1, 1], []), by simp [s3], [0], rfl, rfl⟩ : Step s3 [1, 1, 0] [0])

/-- Every critical branching of `s3` is resolved by one of the five cells of `s3Basis`. -/
theorem resolves (b : Branching s3) (hb : b ∈ criticalBranchings s3) : Resolves s3Basis b := by
  obtain ⟨src, t₁, t₂, ⟨p₁, r₁, m₁, s₁, hs₁, ht₁⟩, ⟨p₂, r₂, m₂, s₂, hs₂, ht₂⟩⟩ := b
  obtain ⟨hne, hni, hp, hs⟩ := hb
  have hc := classify m₁ m₂ (hs₁.symm.trans hs₂) hne (fun h => hni (Or.inl h))
    (fun h => hni (Or.inr h)) hp hs
  clear hne hni hp hs
  rcases hc with ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ |
    ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ |
    ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ |
    ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ |
    ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩ <;>
    subst hs₁ ht₁ ht₂
  · exact ⟨[0], .nil _, .nil _, trivial, trivial, Or.inl (Or.inl rfl)⟩
  · exact ⟨[0], .nil _, .nil _, trivial, trivial, Or.inr (Or.inl rfl)⟩
  · exact ⟨[1], .nil _, .nil _, trivial, trivial, Or.inl (Or.inr (Or.inl rfl))⟩
  · exact ⟨[1], .nil _, .nil _, trivial, trivial, Or.inr (Or.inr (Or.inl rfl))⟩
  · exact ⟨[0, 1], .nil _, resBBAB, trivial, trivial, Or.inl (Or.inr (Or.inr (Or.inl rfl)))⟩
  · exact ⟨[0, 1], resBBAB, .nil _, trivial, trivial, Or.inr (Or.inr (Or.inr (Or.inl rfl)))⟩
  · exact ⟨[1, 0], resBABB, .nil _, trivial, trivial,
      Or.inl (Or.inr (Or.inr (Or.inr (Or.inl rfl))))⟩
  · exact ⟨[1, 0], .nil _, resBABB, trivial, trivial,
      Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))⟩
  · exact ⟨[0], resBABABLeft, resBABABRight, trivial, trivial,
      Or.inl (Or.inr (Or.inr (Or.inr (Or.inr rfl))))⟩
  · exact ⟨[0], resBABABRight, resBABABLeft, trivial, trivial,
      Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))⟩

theorem reflTransGen_of_positive {u v : List (Fin 2)} (p : Path s3 u v) (hp : p.Positive) :
    Relation.ReflTransGen (Rewrites s3) u v := by
  induction p with
  | nil => exact .refl
  | fwd p s ih => exact .tail (ih hp) ⟨s⟩
  | bwd p s ih => exact hp.elim

theorem joinable (b : Branching s3) (hb : b ∈ criticalBranchings s3) :
    Joinable s3 b.tgt₁ b.tgt₂ := by
  obtain ⟨t, ρ₁, ρ₂, h₁, h₂, -⟩ := resolves b hb
  exact ⟨t, reflTransGen_of_positive ρ₁ h₁, reflTransGen_of_positive ρ₂ h₂⟩

end S3Aux

end Squier
